<odoo>
    <record id="res_config_settings_view_form_expanded_access" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.serichai.project.security</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="project.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='tasks_management']" position="after">
                <block title="Task List Viewer Role" id="serichai_project_security_expanded_access">
                    <setting
                        id="serichai_expanded_access_project_setting"
                        help="Users with only the 'Task List Viewer (Production Planning Only)' role may open the task form and edit existing tasks in this project. Every other project keeps their normal read-only, list-only access."
                    >
                        <field name="serichai_expanded_access_project_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
