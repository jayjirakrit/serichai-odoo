<odoo>
    <!-- Restricted list view: same base as the standard All Tasks list
         (project.view_task_tree2), with defense-in-depth / column hiding
         attributes added incrementally by later user stories. -->
    <record id="view_task_list_restricted" model="ir.ui.view">
        <field name="name">project.task.list.restricted</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="open_form_view">false</attribute>
            </list>
        </field>
    </record>

    <record id="action_task_all_restricted" model="ir.actions.act_window">
        <field name="name">All Tasks</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_task_list_restricted"/>
        <field name="group_ids" eval="[(4, ref('group_project_task_list_only'))]"/>
    </record>
</odoo>
