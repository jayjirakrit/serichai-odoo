<odoo>
    <!-- Restricted list view: same base as the standard All Tasks list
         (project.view_task_tree2), with defense-in-depth / column hiding
         attributes added incrementally by later user stories. -->
    <record id="view_task_list_restricted" model="ir.ui.view">
        <field name="name">project.task.list.restricted</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="open_form_view">false</attribute>
            </list>
            <!-- Spec 001 FR-006: no Tags column for the restricted role. -->
            <field name="tag_ids" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
        </field>
    </record>

    <record id="action_task_all_restricted" model="ir.actions.act_window">
        <field name="name">All Tasks</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_task_list_restricted"/>
        <field name="group_ids" eval="[(4, ref('group_project_task_list_only'))]"/>
    </record>

    <!-- Expanded-access entry point: Kanban board (stage columns) + list + form, domain-filtered
         to only the project an administrator has pinned via Settings > Project. The list keeps
         the default open_form_view (true), unlike "All Tasks" above. This is the only place a
         Task List Viewer user can open a task's form - see
         specs/006-product-dev-task-access/research.md Decisions 3 and 5. The action is opened
         through action_server_task_product_development_restricted below, which injects the
         pinned project as default_project_id so every stage of it shows as a column. -->
    <!-- create/delete/group_* are set explicitly rather than left to view post-processing:
         project_todo grants base.group_user full CRUD ACLs on project.task (record rules are
         what actually block create/unlink in projects), so the arch would otherwise still show
         New / quick-create buttons that can only fail on save. -->
    <record id="view_task_list_expanded_access" model="ir.ui.view">
        <field name="name">project.task.list.expanded.access</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="delete">0</attribute>
            </list>
        </field>
    </record>

    <record id="view_task_kanban_expanded_access" model="ir.ui.view">
        <field name="name">project.task.kanban.expanded.access</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <kanban position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="delete">0</attribute>
                <attribute name="quick_create">0</attribute>
                <attribute name="group_create">0</attribute>
                <attribute name="group_edit">0</attribute>
                <attribute name="group_delete">0</attribute>
            </kanban>
        </field>
    </record>

    <record id="action_task_product_development_restricted" model="ir.actions.act_window">
        <field name="name">Project</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_expanded_access_task', '=', True)]</field>
        <field name="search_view_id" ref="project.view_task_search_form"/>
        <field name="group_ids" eval="[(4, ref('group_project_task_list_only'))]"/>
    </record>

    <record id="action_task_product_development_restricted_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_task_kanban_expanded_access"/>
        <field name="act_window_id" ref="action_task_product_development_restricted"/>
    </record>

    <record id="action_task_product_development_restricted_view_list" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_task_list_expanded_access"/>
        <field name="act_window_id" ref="action_task_product_development_restricted"/>
    </record>

    <record id="action_server_task_product_development_restricted" model="ir.actions.server">
        <field name="name">Product Development</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_expanded_access_tasks()</field>
        <field name="group_ids" eval="[(4, ref('group_project_task_list_only'))]"/>
    </record>
</odoo>
