<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_contract_mo">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.internal_layout">
                <div class="page" style="font-size: 0.85rem;">
                    <h2 class="mb-1">Contract MO</h2>
                    <div class="row mb-1">
                        <h4 class="mb-0"><span t-field="o.name">ชื่อสัญญา</span></h4>
                    </div>

                    <t t-set="task_properties" t-value="o._get_report_task_properties()"/>
                    <div t-if="task_properties" class="mb-2">
                        <div t-foreach="task_properties" t-as="task_property" class="mb-1"
                             style="display: inline-block; width: 33.333%; vertical-align: top; box-sizing: border-box;">
                            <strong><span t-esc="task_property['string']">เลขที่สัญญา</span>:</strong>
                            <span t-esc="task_property['value']">A-001</span>
                        </div>
                    </div>

                    <div class="row mb-1">
                        <div class="col-5">
                            <h4 class="mb-0">Manufacturing Order</h4>
                        </div>
                    </div>

                    <table class="table table-bordered table-sm mb-1" style="font-size: 0.85rem;">
                        <thead>
                            <tr>
                                <th style="width: 25%">Manufacturing Order</th>
                                <th>Product</th>
                                <th class="text-end" style="width: 20%">Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.mrp_production_ids" t-as="mo" style="height: 1.4em;">
                                <td class="p-1"><span t-field="mo.name">WH/MO/00001</span></td>
                                <td class="p-1"><span t-field="mo.product_id.display_name">Product [Size: M]</span></td>
                                <td class="text-end p-1">
                                    <span t-field="mo.product_qty">2</span>
                                    <span t-field="mo.product_uom_id.name">ตัว</span>
                                </td>
                            </tr>
                            <tr t-foreach="range(max(0, 15 - len(o.mrp_production_ids)))" t-as="blank_row" style="height: 1.4em;">
                                <td class="p-1">&#160;</td><td class="p-1">&#160;</td><td class="p-1">&#160;</td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="table table-borderless mb-1" style="page-break-inside: avoid;">
                        <tbody>
                            <tr>
                                <td class="p-0">
                                    <strong>หมายเหตุ / Remarks:</strong>
                                    <span t-field="o.description"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="table table-borderless mt-1 text-center" style="page-break-inside: avoid;">
                        <tbody>
                            <tr>
                                <td class="p-1" style="width: 50%">.....................................................</td>
                                <td class="p-1" style="width: 50%">.....................................................</td>
                            </tr>
                            <tr>
                                <td class="p-0">( &#160;&#160;&#160;&#160; / &#160;&#160;&#160;&#160; / &#160;&#160;&#160;&#160; )</td>
                                <td class="p-0" t-if="o.user_ids">( <span t-esc="', '.join(o.user_ids.mapped('name'))">John Doe</span> )</td>
                                <td class="p-0" t-else="1">( &#160;&#160;&#160;&#160; / &#160;&#160;&#160;&#160; / &#160;&#160;&#160;&#160; )</td>
                            </tr>
                            <tr>
                                <td class="p-0">หัวหน้าแผนกเย็บ</td>
                                <td class="p-0">ผู้สั่งผลิต</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </t>
</template>
</odoo>
