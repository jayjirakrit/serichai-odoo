#. module: serichai_project_mo
#: model:mail.template,body_html:serichai_project_mo.mail_template_all_mos_done
msgid ""
"<t t-set=\"productions\" t-value=\"object.env['mrp.production'].search([('project_id', '=', object.id), ('state', '!=', 'cancel')], order='name')\"/>\n"
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"padding:24px 0;font-family:'Segoe UI',Arial,sans-serif;border-collapse:collapse;\">\n"
"<tbody><tr><td align=\"center\" style=\"background-color:#f3f4f6;\">\n"
"  <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"800\" style=\"max-width:800px;border:1px solid #e5e7eb;border-collapse:collapse;font-family:'Segoe UI',Arial,sans-serif;\">\n"
"    <tbody>\n"
"    <tr>\n"
"      <td style=\"background-color:#1f3a5f;padding:20px 28px;\">\n"
"        <div style=\"font-size:12px;letter-spacing:1px;color:#b8c7dc;text-transform:uppercase;\">Serichai Group · Production</div>\n"
"        <div style=\"padding-top:6px;font-size:22px;font-weight:bold;color:#ffffff;\">All Finished Goods Have Been Produced</div>\n"
"      </td>\n"
"    </tr>\n"
"    <tr>\n"
"      <td style=\"padding:24px 28px 8px;font-size:14px;line-height:1.6;color:#111827;background-color:#ffffff;\">\n"
"        Dear <t t-out=\"object.user_id.name or 'Project Manager'\"/>,<br/><br/>\n"
"        All manufacturing orders of this project are done.\n"
"      </td>\n"
"    </tr>\n"
"    <tr>\n"
"      <td style=\"padding:12px 28px;background-color:#ffffff;\">\n"
"        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border:1px solid #e5e7eb;border-left:4px solid #1f3a5f;border-collapse:collapse;\">\n"
"          <tbody>\n"
"          <tr>\n"
"            <td width=\"35%\" style=\"padding:10px 14px;font-size:13px;color:#6b7280;border-bottom:1px solid #e5e7eb;background-color:#ffffff;\">Project</td>\n"
"            <td style=\"padding:10px 14px;font-size:14px;font-weight:bold;color:#111827;border-bottom:1px solid #e5e7eb;background-color:#ffffff;\"><t t-out=\"object.name or '-'\"/></td>\n"
"          </tr>\n"
"          <tr>\n"
"            <td style=\"padding:10px 14px;font-size:13px;color:#6b7280;border-bottom:1px solid #e5e7eb;background-color:#ffffff;\">Project Manager</td>\n"
"            <td style=\"padding:10px 14px;font-size:14px;color:#111827;border-bottom:1px solid #e5e7eb;background-color:#ffffff;\"><t t-out=\"object.user_id.name or '-'\"/></td>\n"
"          </tr>\n"
"          <tr>\n"
"            <td style=\"padding:10px 14px;font-size:13px;color:#6b7280;background-color:#ffffff;\">Manufacturing Orders</td>\n"
"            <td style=\"padding:10px 14px;font-size:14px;color:#111827;background-color:#ffffff;\"><t t-out=\"len(productions)\"/> done</td>\n"
"          </tr>\n"
"          </tbody>\n"
"        </table>\n"
"      </td>\n"
"    </tr>\n"
"    <tr>\n"
"      <td style=\"padding:8px 28px 12px;background-color:#ffffff;\">\n"
"        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border:1px solid #e5e7eb;border-collapse:collapse;\">\n"
"          <thead>\n"
"          <tr style=\"background-color:#f3f4f6;\">\n"
"            <th align=\"left\" style=\"padding:10px 14px;font-size:13px;color:#6b7280;border-bottom:1px solid #e5e7eb;\">Manufacturing Order</th>\n"
"            <th align=\"left\" style=\"padding:10px 14px;font-size:13px;color:#6b7280;border-bottom:1px solid #e5e7eb;\">Product</th>\n"
"            <th align=\"right\" style=\"padding:10px 14px;font-size:13px;color:#6b7280;border-bottom:1px solid #e5e7eb;\">Quantity</th>\n"
"          </tr>\n"
"          </thead>\n"
"          <tbody>\n"
"          <t t-foreach=\"productions\" t-as=\"mo\">\n"
"          <tr>\n"
"            <td style=\"padding:10px 14px;font-size:14px;font-weight:bold;color:#111827;border-bottom:1px solid #e5e7eb;background-color:#ffffff;\"><t t-out=\"mo.name\"/></td>\n"
"            <td style=\"padding:10px 14px;font-size:14px;color:#111827;border-bottom:1px solid #e5e7eb;background-color:#ffffff;\"><t t-out=\"mo.product_id.display_name\"/></td>\n"
"            <td align=\"right\" style=\"padding:10px 14px;font-size:14px;color:#111827;border-bottom:1px solid #e5e7eb;background-color:#ffffff;\"><t t-out=\"mo.product_qty\"/> <t t-out=\"mo.product_uom_id.name\"/></td>\n"
"          </tr>\n"
"          </t>\n"
"          </tbody>\n"
"        </table>\n"
"      </td>\n"
"    </tr>\n"
"    <tr>\n"
"      <td align=\"center\" style=\"padding:20px 28px 24px;background-color:#ffffff;\">\n"
"        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;\">\n"
"          <tbody><tr>\n"
"            <td align=\"center\" bgcolor=\"#1f3a5f\" style=\"background-color:#1f3a5f;\">\n"
"              <a t-attf-href=\"{{ object.get_base_url() }}/odoo/action-project.open_view_project_all/{{ object.id }}\" style=\"display:inline-block;padding:12px 28px;font-size:14px;font-weight:bold;text-decoration:none;font-family:'Segoe UI',Arial,sans-serif;\"><font style=\"color:#ffffff;\">View Project in Odoo</font></a>\n"
"            </td>\n"
"          </tr></tbody>\n"
"        </table>\n"
"      </td>\n"
"    </tr>\n"
"    <tr>\n"
"      <td style=\"background-color:#ffffff;padding:16px 28px;font-size:12px;color:#6b7280;line-height:1.5;border-top:1px solid #e5e7eb;\">\n"
"        Best regards,<br/>\n"
"        <strong>Serichai Company</strong><br/>\n"
"        This is an automated notification from Odoo. Please do not reply to this email.\n"
"      </td>\n"
"    </tr>\n"
"    </tbody>\n"
"  </table>\n"
"</td></tr></tbody>\n"
"</table>\n"
"        "
msgstr ""

